datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  VENDOR
  CUSTOMER
}

enum StoreStatus {
  PENDING_KYC
  UNDER_REVIEW
  ACTIVE
  SUSPENDED
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  JAZZCASH
  EASYPAISA
  SADAPAY
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  name         String?
  email        String    @unique
  whatsapp     String?   @unique
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  store        Store?
  orders       Order[]
  reviews      Review[]
  addresses    Address[]
}

model Store {
  id              String       @id @default(cuid())
  userId          String       @unique
  brandName       String
  slug            String       @unique
  brandAddress    String
  city            String
  area            String?
  latitude        Float?
  longitude       Float?
  commissionRate  Float        @default(0.10) // 10% platform commission
  status          StoreStatus  @default(PENDING_KYC)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kycRecord       VendorKYC?
  products        Product[]
  subOrders       SubOrder[]
}

model VendorKYC {
  id              String     @id @default(cuid())
  storeId         String     @unique
  cnicNumber      String     @unique
  cnicFrontUrl    String
  cnicBackUrl     String
  bankName        String
  ibanNumber      String
  accountTitle    String
  status          KycStatus  @default(PENDING)
  rejectionReason String?
  submittedAt     DateTime   @default(now())
  reviewedAt      DateTime?

  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Product {
  id          String           @id @default(cuid())
  storeId     String
  categoryId  String
  title       String
  brand       String?
  slug        String           @unique
  description String
  basePrice   Float
  images      String[]
  isActive    Boolean          @default(true)
  isApproved  Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category    Category         @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  reviews     Review[]
}

model ProductVariant {
  id          String      @id @default(cuid())
  productId   String
  sku         String      @unique
  variantName String      // e.g. "256GB / Natural Titanium" or "Size 42 / Black"
  price       Float
  stock       Int         @default(0)
  attributes  Json        // { "storage": "256GB", "color": "Titanium" }

  product     Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems  OrderItem[]
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  fullName   String
  whatsapp   String
  street     String
  area       String
  city       String
  latitude   Float?
  longitude  Float?
  isDefault  Boolean  @default(false)

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders     Order[]
}

model Order {
  id                String        @id @default(cuid())
  customerId        String
  shippingAddressId String
  totalAmount       Float
  paymentMethod     PaymentMethod
  paymentStatus     PaymentStatus @default(UNPAID)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  customer          User          @relation(fields: [customerId], references: [id])
  shippingAddress   Address       @relation(fields: [shippingAddressId], references: [id])
  subOrders         SubOrder[]
}

model SubOrder {
  id             String       @id @default(cuid())
  orderId        String
  storeId        String
  status         OrderStatus  @default(PENDING)
  subtotal       Float
  platformFee    Float
  vendorEarnings Float
  riderName      String?
  riderPhone     String?
  riderLatitude  Float?
  riderLongitude Float?
  trackingNumber String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  store          Store        @relation(fields: [storeId], references: [id])
  items          OrderItem[]
}

model OrderItem {
  id         String         @id @default(cuid())
  subOrderId String
  variantId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  subOrder   SubOrder       @relation(fields: [subOrderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  review     Review?
}

model Review {
  id          String    @id @default(cuid())
  productId   String
  orderItemId String    @unique
  userId      String
  ratingStars Int       // 1 to 5 Stars
  comment     String?
  createdAt   DateTime  @default(now())

  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
